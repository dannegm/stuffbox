# client (Next uses NEXT_PUBLIC_ for browser-exposed vars)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ORS_API_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_NTFY_TOPIC=
# public base url items are served from — bucket (or a custom domain pointed
# at it) must have R2 public access enabled; no trailing slash. Consumed by
# the `endpoints` repo's photo-resize proxy (as STUFFBOX__R2_PUBLIC_URL),
# not read directly by this app anymore — see NEXT_PUBLIC_PHOTO_PROXY_URL
NEXT_PUBLIC_R2_PUBLIC_URL=
# base url of the endpoints photo-resize proxy (endpoints/src/endpoints/
# stuffbox/router.js) — every photo url in the app is built as
# `${NEXT_PUBLIC_PHOTO_PROXY_URL}/stuffbox/photo/${sizeId}/${r2_key}`
# (src/helpers/photos.js); no trailing slash
NEXT_PUBLIC_PHOTO_PROXY_URL=
# the image pipeline runs client-side, so this must be NEXT_PUBLIC_ to be read
NEXT_PUBLIC_STUFFBOX_MAX_IMAGE_DIMENSION=2000
# used to build absolute QR urls (/i/[id], /l/[id]) baked into printed labels —
# no trailing slash, e.g. https://stuffbox.example.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# server-only (Route Handlers)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=              # full https://<account_id>.r2.cloudflarestorage.com — copy as-is from Cloudflare's R2 API page
RESEND_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter model slug, e.g. anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=
# optional — @openrouter/ai-sdk-provider defaults to https://openrouter.ai/api/v1, only set to override
OPENROUTER_BASE_URL=
